# Скопируйте в .env и заполните. НЕ коммитьте .env.

SESSION_SECRET=change-me-long-random-string
ADMIN_INIT_PASSWORD=your-admin-password
ADMIN_RESET_TOKEN=reset-token-for-emergency
# COOKIE_SECURE=1
# CORS_ORIGINS=https://your-domain.com

# --- Alice warehouse (голосовой склад) ---
TMS_BASE_URL=https://tmsdesk.ru
TMS_API_TOKEN=
TMS_OPERATOR=Alice-Warehouse
ALICE_WAREHOUSE_DRY_RUN=true
ALICE_MAX_STOCK_CHANGE=1000
ALICE_SESSION_TTL_SECONDS=1800
ALICE_PENDING_TTL_SECONDS=60
ALICE_DEDUP_TTL_SECONDS=300
# Опционально: ID навыка из консоли Диалогов
# ALICE_SKILL_ID=
# Опционально: секрет в query (?secret=...) или заголовке X-Alice-Secret
# ALICE_WEBHOOK_SECRET=
